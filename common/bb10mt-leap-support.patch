 bb10mt.ini    |  1 +
 docs/LINUX.md | 56 +++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 57 insertions(+)
 create mode 100644 docs/LINUX.md

diff --git a/bb10mt.ini b/bb10mt.ini
index 932c662..4254eda 100644
--- a/bb10mt.ini
+++ b/bb10mt.ini
@@ -30,6 +30,7 @@
 06001404=LDR_09
 06001a06=LDR_01
 0600260a=LDR_24
+06002e0a=LDR_29
 07001204=LDR_25
 07001404=LDR_09
 07001504=LDR_26
