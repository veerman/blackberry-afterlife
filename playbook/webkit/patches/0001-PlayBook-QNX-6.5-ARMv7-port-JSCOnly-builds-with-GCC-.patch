diff --git a/Source/WTF/wtf/StackBounds.cpp b/Source/WTF/wtf/StackBounds.cpp
index e9d9d583..824c1f3e 100644
--- a/Source/WTF/wtf/StackBounds.cpp
+++ b/Source/WTF/wtf/StackBounds.cpp
@@ -21,6 +21,10 @@
 #include "config.h"
 #include <wtf/StackBounds.h>
 
+#if OS(QNX)
+#include <sys/storage.h>
+#endif
+
 #if OS(DARWIN)
 
 #include <pthread.h>
@@ -86,7 +90,21 @@ StackBounds StackBounds::newThreadStackBounds(PlatformThreadHandle thread)
     return StackBounds { origin, bound };
 }
 
-#else // !OS(OPENBSD)
+#elif OS(QNX)
+
+StackBounds StackBounds::newThreadStackBounds(PlatformThreadHandle thread)
+{
+    // QNX has no pthread_getattr_np. Only the current thread asks for its own bounds:
+    // its thread local storage sits at the top of its stack and records the stack base.
+    RELEASE_ASSERT(thread == pthread_self());
+    UNUSED_PARAM(thread);
+    struct _thread_local_storage* tls = __tls();
+    void* origin = tls;
+    void* bound = tls->__stackaddr;
+    return StackBounds { origin, bound };
+}
+
+#else // !OS(OPENBSD) && !OS(QNX)
 
 StackBounds StackBounds::newThreadStackBounds(PlatformThreadHandle thread)
 {
