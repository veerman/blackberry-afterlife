# CMake cross toolchain: BlackBerry PlayBook (QNX 6.5, ARMv7) with Psyden GCC 9.3.
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_VERSION 6.5.0)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(PB_TOOLCHAIN ${CMAKE_CURRENT_LIST_DIR}/../sdk/psyden-gcc9/playbook-gcc9/qnx650)
set(CMAKE_C_COMPILER ${PB_TOOLCHAIN}/bin/arm-blackberry-qnx8eabi-gcc)
set(CMAKE_CXX_COMPILER ${PB_TOOLCHAIN}/bin/arm-blackberry-qnx8eabi-g++)
set(CMAKE_AR ${PB_TOOLCHAIN}/bin/arm-blackberry-qnx8eabi-ar CACHE FILEPATH "")
set(CMAKE_RANLIB ${PB_TOOLCHAIN}/bin/arm-blackberry-qnx8eabi-ranlib CACHE FILEPATH "")
set(PB_FLAGS "-march=armv7-a -mtune=cortex-a9 -mfpu=neon -mfloat-abi=softfp -mthumb -I${CMAKE_CURRENT_LIST_DIR}/sysroot/include -include ${CMAKE_CURRENT_LIST_DIR}/qnx-compat/qnx_compat.h")
set(CMAKE_C_FLAGS_INIT "${PB_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${PB_FLAGS}")
set(CMAKE_FIND_ROOT_PATH ${CMAKE_CURRENT_LIST_DIR}/sysroot ${PB_TOOLCHAIN}/arm-blackberry-qnx8eabi ${PB_TOOLCHAIN})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
